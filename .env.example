# Copia este archivo como .env y rellena los valores

# Base de datos MongoDB
# Local:
MONGODB_URI=mongodb://localhost:27017/gymAppBD
# Atlas (nube):
# MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/gymAppBD

# Seguridad JWT (cámbialo por una cadena secreta larga y aleatoria)
JWT_SECRET=tu_secreto_jwt_super_seguro

# Puerto del servidor backend (por defecto 5001)
PORT=5001

# Entorno (development | production)
NODE_ENV=development

# URL del backend (usada para construir URLs de archivos en emails)
BACKEND_URL=http://localhost:5001

# Webhook de n8n para envío de emails (opcional)
N8N_WEBHOOK_URL=https://tu-instancia-n8n.com/webhook/tu-webhook-id
